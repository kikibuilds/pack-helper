{
  "manifest_version": 3,
  "name": "发货助手 Pack Helper",
  "version": "0.8.6",
  "description": "从 Poshmark、Mercari、Depop、Whatnot 收集待发货订单和预付面单，生成带图片的拣货单 + 面单的发货文件 (.zip)。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "unlimitedStorage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://*.ebay.com/*",
    "https://*.ebayimg.com/*",
    "https://*.poshmark.com/*",
    "https://*.cloudfront.net/*",
    "https://*.amazonaws.com/*",
    "https://*.mercari.com/*",
    "https://*.mercdn.net/*",
    "https://*.depop.com/*",
    "https://*.whatnot.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "发货助手：打开批次页",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "https://*.depop.com/*"
      ],
      "js": [
        "lib/nethook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
